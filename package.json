{
  "name": "dsh-session-workspace",
  "version": "0.1.0",
  "description": "Move cold DeepSeek Harness sessions between registered workspaces",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs && node --check src/index.js && node --check src/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "workspace"
  ],
  "author": "Unintended",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unintendedz/dsh-session-workspace.git"
  },
  "homepage": "https://github.com/Unintendedz/dsh-session-workspace#readme",
  "bugs": {
    "url": "https://github.com/Unintendedz/dsh-session-workspace/issues"
  }
}
