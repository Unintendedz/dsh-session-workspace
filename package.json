{
  "name": "dsh-session-workspace",
  "version": "0.2.4",
  "description": "Move cold DeepSeek Harness sessions between registered workspaces",
  "main": "src/index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs && node --check src/index.js && node --check src/client.js",
    "build": "node scripts/build-client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "workspace"
  ],
  "author": "Unintended",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unintendedz/dsh-session-workspace.git"
  },
  "homepage": "https://github.com/Unintendedz/dsh-session-workspace#readme",
  "bugs": {
    "url": "https://github.com/Unintendedz/dsh-session-workspace/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "jsdom": "26.1.0",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-format-catalog": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-format-catalog": {
      "optional": true
    }
  }
}
